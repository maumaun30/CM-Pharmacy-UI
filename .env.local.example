NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME='Pharmacy POS'
# Google OAuth *Web* client id (same one used as the API's Web audience and the
# Expo webClientId). Public by design — it only identifies the app to Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com